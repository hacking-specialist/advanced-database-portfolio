digraph G {graph [rankdir=LR, splines=polyline, nodesep=.5, ranksep=1.1, bgcolor="white"]; node [shape=record,style="rounded,filled",fillcolor="#eef4fa",color="#5b7896",fontname="DejaVu Sans",fontsize=10];
